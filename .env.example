# dsimaging-store configuration
# Copy to .env and edit as needed

# MinIO credentials (generate unique random values; no built-in defaults)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Ports
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
CONTROLLER_PORT=8080

# Bucket name for imaging datasets
BUCKET_NAME=imaging-data

# Controller debounce/reconcile loop
RECONCILE_INTERVAL_SECONDS=10
DSIMAGING_MAX_WEBHOOK_BODY_BYTES=1048576

# Required to enable GET /datasets and POST /reconcile/<dataset-id>.
# Generate a long random value and send it as Authorization: Bearer <token>.
DSIMAGING_CONTROLLER_TOKEN=

# Required dedicated bearer sent by MinIO to POST /webhook/minio.
# Keep it distinct from the operator token.
DSIMAGING_WEBHOOK_TOKEN=

# Init retries while MinIO notification targets become available
WEBHOOK_RETRIES=12
WEBHOOK_RETRY_SECONDS=5

# Optional override after deliberately building a local controller image:
# DSIMAGING_STORE_CONTROLLER_IMAGE=dsimaging-store-controller:local
